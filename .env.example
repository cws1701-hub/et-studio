# 인스타그램 Graph API — docs/INSTAGRAM_SETUP.md 참고
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# football-data.org API 키 (https://www.football-data.org/client/register) — scripts/fetch_matches.py에서 사용
FOOTBALL_DATA_API_KEY=

# API-SPORTS(api-football) 직접 구독 키 (https://dashboard.api-football.com/) — scripts/fetch_match_events.py에서 사용
# 주의: RapidAPI 경유가 아닌 API-SPORTS 직접 구독 키입니다 (x-apisports-key 헤더 사용).
APIFOOTBALL_KEY=

# ElevenLabs TTS (나레이션 음성 합성) — scripts/generate_tts.py에서 사용
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# 인스타그램용 영상 공개 호스팅 — scripts/publish_video.py에서 사용 (docs/VIDEO_PIPELINE.md 참고)
# 형식: owner/repo (공개 저장소여야 함, Graph API가 raw.githubusercontent.com URL을 읽을 수 있어야 함)
VIDEO_ASSETS_REPO=
# VIDEO_ASSETS_REPO push용 GitHub 토큰 (로컬에서 실행 시 git 인증이 이미 되어 있다면 생략 가능)
GITHUB_TOKEN=

# 유튜브 업로드 (YouTube Data API v3) — scripts/upload_youtube.py에서 사용
# 최초 1회 scripts/youtube_oauth_setup.py로 발급 (docs/YOUTUBE_SETUP.md 참고)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
